#!/usr/bin/env python3

import argparse
import http.server
import json
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument("command", choices=("serve",))
parser.add_argument("model")
for flag in ("--model-dir", "--manifest", "--api-key-file"):
    parser.add_argument(flag, type=Path, required=True)
parser.add_argument("--port", type=int, required=True)
parser.add_argument("--context-limit", type=int, required=True)
parser.add_argument("--host", default="127.0.0.1")
args = parser.parse_args()
assert (args.model_dir / args.manifest.name).is_file()
key = args.api_key_file.read_text().strip()


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *_):
        pass

    def reply(self, body):
        if self.headers.get("Authorization") != "Bearer " + key:
            self.send_error(401)
            return
        data = json.dumps(body).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/health":
            self.reply({"status": "ok"})
        elif self.path == "/v1/models":
            self.reply({"data": [{"id": args.model}]})
        else:
            self.send_error(404)

    def do_POST(self):
        self.rfile.read(int(self.headers["Content-Length"]))
        message = {"role": "assistant", "content": "hello"}
        self.reply({"choices": [{"index": 0, "message": message, "finish_reason": "stop"}]})


http.server.ThreadingHTTPServer((args.host, args.port), Handler).serve_forever()
